# When both values are set, the server automatically uses Supabase instead of
# the local driver. Obtain them from the Supabase project API settings.
SUPABASE_URL=

# SECURITY: server-only service-role secret. Never expose it to browser code,
# prefix it with NEXT_PUBLIC_, print it in logs, or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Supported drivers: file (durable local development) or memory (disposable demo).
LIFESTYLE_STORAGE_DRIVER=file

# Used only by the file driver. Keep this path out of version control.
LIFESTYLE_DATA_FILE=.data/lifestyle-gym.json

# For an explicit disposable demo, set LIFESTYLE_STORAGE_DRIVER=memory.
# LIFESTYLE_STORAGE_DRIVER=memory
